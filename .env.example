OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
MAX_OUTPUT_TOKENS=350
MODEL_INPUT_PRICE_PER_MILLION=2.50
MODEL_OUTPUT_PRICE_PER_MILLION=10.00
APP_ENV=development
LOG_LEVEL=INFO
TOOL_MODE=mock
ALLOWED_SERVICES=auth-service,payment-gateway
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256
SEMANTIC_MEMORY_THRESHOLD=0.96
IMAGE_GENERATION_ENABLED=true
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium
GENERATED_IMAGE_DIR=web/generated
MAX_INPUT_CHARS=2000
MAX_CONTEXT_MESSAGES=6
MAX_AGENT_STEPS=4
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=my-langgraph-project
LANGSMITH_ENDPOINT=
MEMORY_DB_PATH=data/agent_memory.db
AUDIT_LOG_PATH=data/audit.jsonl
USAGE_ADMIN_KEY=
